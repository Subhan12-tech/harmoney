# --- secrets ---
.env
.env.*
!.env.example
# Committed on purpose: points the dev server at the local API. No secret in it,
# and next build ignores .env.development, so it cannot leak into production.
!harmony-web/.env.development

# --- local data (contains real users + password hashes) ---
*.db
*.sqlite
*.sqlite3
db/

# --- python ---
venv/
.venv/
__pycache__/
*.pyc

# --- node / next ---
node_modules/
.next/
out/
harmony-web/out/
*.tsbuildinfo

# --- scratch ---
err*.txt
ERROR.txt
