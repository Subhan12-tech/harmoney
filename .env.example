# Copy to .env for local dev, or set these as environment variables on your host.
# NEVER commit the filled-in .env — it is gitignored.

# --- AI core (required) ---
MISTRAL_API_KEY=
QDRANT_URL=https://xxxx.cloud.qdrant.io
QDRANT_API_KEY=

# --- PLATFORM OWNER (you) ---
# The one account that grants and revokes customer access. When this address
# signs up or logs in it is promoted to superadmin automatically, so there is
# no CLI step needed on a host where you cannot run scripts.
PLATFORM_OWNER_EMAIL=

# How a new signup is treated:
#   approval (default) -> org created "pending"; unusable until YOU approve it
#   open               -> org active immediately (self-serve / demo)
HARMONY_SIGNUP_MODE=approval

# --- Security (REQUIRED in production; app refuses to boot without it) ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
APP_SECRET_KEY=
APP_ENV=development

# --- Database ---
# Leave blank for local SQLite. In production this MUST be Postgres — most hosts
# have an ephemeral filesystem, so a SQLite file is wiped on every deploy/restart.
# APP_DATABASE_URL=postgresql://user:pass@host:5432/harmony

# --- LangSmith tracing ---
# Forced OFF when APP_ENV=production. Turning it on sends every customer draft
# and every retrieved history chunk to LangSmith, which makes them a
# sub-processor your customers have not agreed to. Only set this if you mean it.
# HARMONY_ALLOW_TRACING=false

# Seconds before a Qdrant call gives up (startup no longer dies on a blip).
# QDRANT_TIMEOUT=20

# Where harmony-web is deployed. Set this and the API root redirects there
# instead of serving the built-in fallback dashboard.
# FRONTEND_URL=https://harmony-web.vercel.app

# --- EMAIL (verification codes, approval notices) ---
# EASIEST WITH NO DOMAIN: Brevo. Verify one sender address (a plain Gmail works)
# and it will deliver to anyone. Free 300/day, HTTPS API so SMTP blocks do not
# matter. brevo.com -> SMTP & API -> API Keys.
# BREVO_API_KEY=xkeysib-xxxxxxxx
# BREVO_FROM=you@gmail.com
# BREVO_FROM_NAME=Harmony
#
# ALTERNATIVE: Resend. Sends over HTTPS, so it works on hosts that block SMTP
# ports (Render's free tier does). Free 3,000/month at resend.com.
# RESEND_API_KEY=re_xxxxxxxx
# Until you verify a domain, the shared sender below only delivers to the
# address that owns the Resend account.
# RESEND_FROM=Harmony <onboarding@resend.dev>
#
# FALLBACK: SMTP. Ignored when RESEND_API_KEY is set.
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and use THAT here, not your
# account password. Free, ~500 mails/day.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=abcd efgh ijkl mnop
# SMTP_FROM=Harmony <you@gmail.com>

# Used in email links, e.g. the approve button. No trailing slash.
# PUBLIC_URL=https://harmoney.onrender.com

# --- CORS: the frontend origins allowed to call this API ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
